# ---- Model weights & checkpoints (go on Hugging Face Hub, not GitHub) ----
*.pt
*.pth
*.safetensors
checkpoints/*
!checkpoints/.gitkeep

# ---- Tokenized data (regenerated by data_pipeline.py; too big for git) ----
*.npy
tokens.npy

# ---- TensorBoard logs ----
runs/
*.tfevents.*

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/

# ---- Virtual environments ----
venv/
venv311/
env/
.venv/

# ---- Hugging Face cache (if it ever lands in the repo dir) ----
.cache/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.vscode/
.idea/
